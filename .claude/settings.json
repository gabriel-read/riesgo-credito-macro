{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run python -m src.pipeline *)",
      "Bash(uv run python scripts/verify_refs.py *)",
      "Bash(quarto render *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:api.openalex.org)"
    ],
    "deny": [
      "Edit(./data/raw/**)",
      "Edit(./docs/guia-profesor.md)",
      "Bash(git push --force *)"
    ]
  }
}
