{
  "$schema": "https://opencode.ai/config.json",
  // Modelo de la fábrica para build y plan. Los agentes de .opencode/agents/ declaran el suyo.
  // Si OpenCode rechaza la variante "", quita el sufijo aquí y en los agentes, y sube el esfuerzo con Ctrl+T.
  "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "permission": {
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
    "bash": {
      "*": "ask",
      "uv *": "allow",
      "quarto *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git switch*": "allow",
      "git push*": "deny",
      "rm -rf*": "deny"
    }
  }
}
